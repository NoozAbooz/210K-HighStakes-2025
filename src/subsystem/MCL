#include "pros/adi.hpp"
#include "pros/imu.hpp"
#include "pros/llemu.hpp"
#include <vector>
#include <random>
#include <cmath>
#include <main.h>

#define NUM_PARTICLES 100

inline pros::Distance sensor1(1);
inline pros::Distance sensor2(2);
inline pros::Distance sensor3(3);
inline pros::Distance sensor4(4);
inline pros::IMU imu1(5);
inline pros::IMU imu2(6);

struct Particle {
    double x, y, theta, weight;
};

std::vector<Particle> particles(NUM_PARTICLES);
std::random_device rd;
std::mt19937 gen(rd());
std::uniform_real_distribution<double> rand_x(0, 100);
std::uniform_real_distribution<double> rand_y(0, 100);
std::uniform_real_distribution<double> rand_theta(0, 360);
std::normal_distribution<double> noise(0, 0.5);

void initialize_particles() {
    for (auto &p : particles) {
        p.x = rand_x(gen);
        p.y = rand_y(gen);
        p.theta = rand_theta(gen);
        p.weight = 1.0 / NUM_PARTICLES;
    }
}

void predict() {
    double delta_theta = (imu1.get_rotation() + imu2.get_rotation()) / 2.0;
    for (auto &p : particles) {
        p.theta += delta_theta + noise(gen);
        p.x += cos(p.theta * M_PI / 180.0) + noise(gen);
        p.y += sin(p.theta * M_PI / 180.0) + noise(gen);
    }
}

double expected_distance(double x, double y, double theta, int sensor_id) {
    return 50.0;  // Placeholder, implement based on field map
}

bool is_sensor_facing_wall(double theta, int sensor_id) {
    // Define angles at which each sensor is expected to face the walls
    if (sensor_id == 1 && (theta > 315 || theta < 45)) return true;  // Forward-facing
    if (sensor_id == 2 && (theta > 45 && theta < 135)) return true;  // Right-facing
    if (sensor_id == 3 && (theta > 135 && theta < 225)) return true; // Backward-facing
    if (sensor_id == 4 && (theta > 225 && theta < 315)) return true; // Left-facing
    return false;
}

void update_weights() {
    for (auto &p : particles) {
        double error_sum = 0;
        int valid_sensors = 0;
        
        if (is_sensor_facing_wall(p.theta, 1)) {
            error_sum += std::abs(sensor1.get() - expected_distance(p.x, p.y, p.theta, 1));
            valid_sensors++;
        }
        if (is_sensor_facing_wall(p.theta, 2)) {
            error_sum += std::abs(sensor2.get() - expected_distance(p.x, p.y, p.theta, 2));
            valid_sensors++;
        }
        if (is_sensor_facing_wall(p.theta, 3)) {
            error_sum += std::abs(sensor3.get() - expected_distance(p.x, p.y, p.theta, 3));
            valid_sensors++;
        }
        if (is_sensor_facing_wall(p.theta, 4)) {
            error_sum += std::abs(sensor4.get() - expected_distance(p.x, p.y, p.theta, 4));
            valid_sensors++;
        }
        
        p.weight = valid_sensors > 0 ? 1.0 / (error_sum + 1e-6) : 0;
    }
}

void resample() {
    std::vector<Particle> new_particles;
    std::discrete_distribution<int> dist(particles.begin(), particles.end(), [](const Particle &p) { return p.weight; });
    for (int i = 0; i < NUM_PARTICLES; i++) {
        new_particles.push_back(particles[dist(gen)]);
    }
    particles = new_particles;
}

Particle get_estimate() {
    double sum_x = 0, sum_y = 0, sum_theta = 0;
    for (auto &p : particles) {
        sum_x += p.x * p.weight;
        sum_y += p.y * p.weight;
        sum_theta += p.theta * p.weight;
    }
    return {sum_x, sum_y, sum_theta, 1.0};
}

void opcontrol() {
    imu1.reset();
    imu2.reset();
    initialize_particles();

    while (true) {
        predict();
        update_weights();
        resample();

        Particle estimate = get_estimate();
        pros::lcd::print(0, "X: %.2f Y: %.2f Theta: %.2f", estimate.x, estimate.y, estimate.theta);

        pros::delay(100);
    }
}
